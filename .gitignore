.claude/
# Root hardware-configuration.nix (legacy, before flakes)
/hardware-configuration.nix
# Allow hardware configs in hosts/ subdirectories (needed for flakes)
!hosts/*/hardware-configuration.nix
# nix build / nixos-rebuild output symlinks
/result
/result-*
/n-boot
# Accidental HOME-as-literal-tilde dir (e.g. from a script run with $HOME="~")
/~/
# git worktrees for isolated feature work
/.worktrees/
# codegraph's local index, daemon socket, pid and logs. Its own .gitignore
# already covers these, so this entry is belt-and-braces for git tooling.
# NOTE: it does not fix `nix eval` on a path: flake reference — that copies
# the tree verbatim, consulting no ignore files at all, and chokes on
# daemon.sock ("has an unsupported type"). Use git+file:///path (which
# enumerates via git) when evaluating this repo that way.
/.codegraph/
# Design docs / specs / plans (superpowers output) — kept locally, not versioned.
/docs/
