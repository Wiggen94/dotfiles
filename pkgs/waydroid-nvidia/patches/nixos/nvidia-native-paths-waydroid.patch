# Twin of nvidia-native-paths.patch: identical hunks, applied to
# tools/helpers/nvidia_native.py here instead of waydroid/. Keep the bodies in step.
diff -ruN a/tools/helpers/nvidia_native.py b/tools/helpers/nvidia_native.py
--- a/tools/helpers/nvidia_native.py	2026-11-03 08:34:56.091739729 +0100
+++ b/tools/helpers/nvidia_native.py	2026-11-03 08:34:56.093169916 +0100
@@ -254,9 +254,15 @@
 VENUS_SOCKET = "/run/waydroid-venus/venus.sock"
 # Default glibc-shim staging tree written by dev/native-deploy (the glibc-shim link points at it).
 GLIBC_SHIM_STAGING = "/var/lib/waydroid/nvidia-glibc-shim-staging"
+
+# Self-locating, because this file is installed twice: under <prefix>/native in
+# the driver package, and under <prefix>/lib/waydroid/tools/helpers in the patched
+# waydroid, where the arithmetic below resolves to a directory with no bundle.
+_NATIVE_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
+_NATIVE_PARENT = os.path.dirname(_NATIVE_DIR)
 # The privileged helper (packaging/native/wd-native, one NOPASSWD sudoers rule): the packaged copy, or a
 # developer's root-owned copy; WD_NATIVE_HELPER overrides. Only used in messages here.
-WD_NATIVE_HELPERS = ("/usr/lib/waydroid-nvidia/wd-native", "/usr/local/sbin/wd-native")
+WD_NATIVE_HELPERS = (os.path.join(_NATIVE_PARENT, "wd-native"), "/usr/local/sbin/wd-native")
 
 
 def wd_native_helper():
@@ -1749,7 +1755,17 @@
         "    oneshot\n"
 IMAGES_PATH = "/var/lib/waydroid/images"
 # The installed package's release bundle: when present, the image must carry exactly it.
-PACKAGED_BUNDLE_RECORD = "/usr/lib/waydroid-nvidia/native/release/BUILD-RECORD.json"
+# First existing candidate wins. The waydroid copy has no bundle, so there the
+# first candidate is always absent and check_vendor_image() logs the skip.
+PACKAGED_BUNDLE_RECORDS = (
+    os.path.join(_NATIVE_DIR, "release", "BUILD-RECORD.json"),
+    "/usr/lib/waydroid-nvidia/native/release/BUILD-RECORD.json",
+)
+
+
+def packaged_bundle_record():
+    """First existing candidate, else the first candidate (so callers can name it)."""
+    return next((p for p in PACKAGED_BUNDLE_RECORDS if os.path.isfile(p)), PACKAGED_BUNDLE_RECORDS[0])
 RESTORE_OFFICIAL = "sudo waydroid-nvidia-setup --restore-official-vendor"
 
 
@@ -1826,7 +1842,7 @@
     this kernel module (sha256), from the installed package's release; the codec listing is the one that
     gate generated. Returns the install record; raises OSError naming the remedy."""
     state = state or VENDOR_IMAGE_STATE
-    packaged_record = packaged_record or PACKAGED_BUNDLE_RECORD
+    packaged_record = packaged_record or packaged_bundle_record()
     image = vendor_img_path(waydroid)
     props = image_build_props(image)
     where = "NVIDIA driver mode nvidia-prolapse ({} = vendor-image)".format(INSTALL_KEY)
@@ -1847,7 +1863,12 @@
     elif _sha256_file(image) != record["vendor_img"]["sha256"]:
         problems.append("{} is not the file the setup gated (sha256 {} expected)".format(
             image, record["vendor_img"]["sha256"][:16]))
-    if os.path.isfile(packaged_record) and _sha256_file(packaged_record) != record["build_record_sha256"]:
+    if not os.path.isfile(packaged_record):
+        # Expected in the waydroid tree, which has no bundle — but a silent skip
+        # looks exactly like a passing check.
+        print("nvidia_native: no packaged release bundle among {}: the packaged-record cross-check was "
+              "skipped".format(PACKAGED_BUNDLE_RECORDS), file=sys.stderr)
+    elif _sha256_file(packaged_record) != record["build_record_sha256"]:
         problems.append("the installed package carries release bundle {} ({}), the vendor image {} (the package "
                         "was updated after the setup ran)".format(_sha256_file(packaged_record)[:12], packaged_record,
                                                                  record["build_record_sha256"][:12]))
