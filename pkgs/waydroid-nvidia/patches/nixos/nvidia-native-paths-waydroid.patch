-PACKAGED_BUNDLE_RECORD = "/usr/lib/waydroid-nvidia/native/release/BUILD-RECORD.json"
+# Candidates, first existing wins. A packaged install keeps the bundle in its own
+# prefix; the waydroid tree has no bundle at all, so a wrong-but-plausible path
+# there must not silently disable the packaged-record check (it would look like
+# "no record", not "wrong tree").
+PACKAGED_BUNDLE_RECORDS = (
+    os.path.join(_NATIVE_DIR, "release", "BUILD-RECORD.json"),
+    "/usr/lib/waydroid-nvidia/native/release/BUILD-RECORD.json",
+)
+
+
+def packaged_bundle_record():
+    """First existing candidate, else the first candidate (so callers can name it)."""
+    return next((p for p in PACKAGED_BUNDLE_RECORDS if os.path.isfile(p)), PACKAGED_BUNDLE_RECORDS[0])
 RESTORE_OFFICIAL = "sudo waydroid-nvidia-setup --restore-official-vendor"
 
 
