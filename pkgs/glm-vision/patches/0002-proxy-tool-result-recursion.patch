+/**
+ * 递归改写任意 block 数组：image 块换成文字描述，其余 block 若带
+ * content 数组（如 tool_result，Claude Code 读图片文件/截图工具的返回
+ * 都长这样）则继续下钻（local patch）。
+ */
+async function rewriteBlocks(blocks: any[]): Promise<any[]> {
+  return Promise.all(
+    blocks.map(async (b: any) => {
+      if (b?.type === "image") return rewriteImageBlock(b);
+      if (b && Array.isArray(b.content)) {
+        return { ...b, content: await rewriteBlocks(b.content) };
+      }
+      return b;
+    }),
+  );
+}
